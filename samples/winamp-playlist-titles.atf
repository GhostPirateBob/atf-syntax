$iflonger(%artist%,9,$left($replace(%artist%, ,),11),%artist%) ▸$if(%album%, $iflonger(%album%,11,$left($replace(%album%, ,),13),%album%) ▹ , )$if(%title%,$iflonger(%title%,11,$left($replace(%title%, ,),15),%title%),$left($filepart($replace(%filename%, ,)),15))

$if(%title%,$iflonger(%title%,11,$left($replace(%title%, ,),11),%title%),$left($filepart($replace(%filename%, ,)),11))$if(%album%, $iflonger(%album%,11,$left($replace(%album%, ,),11),%album%) ▹ , )$if2(%title%,$filepart(%filename%))

[$trim($iflonger(%artist%,15,$left(%artist%,15),%artist%)) ▹ ]$left($trim([$if2(%title%,$filepart(%filename%))]),15)

