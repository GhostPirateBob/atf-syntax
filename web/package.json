{
  "name": "atf-playground",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "Live ATF (Advanced Title Formatting) playground: type a WACUP title format, see it render for real tracks.",
  "scripts": {
    "dev": "vite --configLoader native --open",
    "build": "vite build --configLoader native",
    "preview": "vite preview --configLoader native",
    "preview:dist": "vite preview --configLoader native --port 4174 --host 127.0.0.1 --strictPort",
    "serve:dist": "npm run build && vite preview --configLoader native --port 4174 --host 127.0.0.1 --strictPort --open",
    "dev:vapor": "vite --configLoader native --mode vapor --open",
    "build:vapor": "vite build --configLoader native --mode vapor",
    "preview:vapor": "vite preview --configLoader native --outDir dist-vapor --port 4180 --host 127.0.0.1 --strictPort",
    "serve:vapor": "npm run build:vapor && vite preview --configLoader native --outDir dist-vapor --port 4180 --host 127.0.0.1 --strictPort --open",
    "type-check": "vue-tsc --build",
    "build:wasm": "node scripts/build-vuio-wasm.mjs",
    "analyze": "vite build --configLoader native --mode analyze",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@floating-ui/dom": "1.8.0",
    "@fontsource-variable/exo": "5.3.0",
    "@fontsource-variable/roboto-condensed": "5.3.0",
    "@fontsource/iosevka-charon-mono": "5.3.0",
    "@fontsource/vt323": "5.3.0",
    "@lucide/vue": "1.64.0",
    "lodash-es": "4.18.1",
    "lz-string": "^1.5.0",
    "minisearch": "7.2.0",
    "vue": "rc"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/lodash-es": "4.17.12",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "rollup-plugin-visualizer": "^7.1.3",
    "typescript": "npm:typescript-native-bridge@latest",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "overrides": {
    "vue": "rc",
    "@vue/compiler-core": "rc",
    "@vue/compiler-dom": "rc",
    "@vue/compiler-sfc": "rc",
    "@vue/compiler-ssr": "rc",
    "@vue/compiler-vapor": "rc",
    "@vue/reactivity": "rc",
    "@vue/runtime-core": "rc",
    "@vue/runtime-dom": "rc",
    "@vue/runtime-vapor": "rc",
    "@vue/server-renderer": "rc",
    "@vue/shared": "rc",
    "typescript": "$typescript"
  }
}
